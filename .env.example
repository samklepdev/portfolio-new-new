# Postgres connection string used by src/db/index.ts, drizzle-kit, and src/db/seed.ts.
# Local (matches docker-compose.yml): postgresql://postgres:postgres@localhost:5432/portfolio
# Hosted (Neon, Supabase, Railway): append ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# Consumed by docker-compose.yml only — the local container's credentials.
# These must stay in sync with DATABASE_URL above. Ignore them entirely if you
# point DATABASE_URL at a hosted database instead of the container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

# Resend API key, used by the contact form to notify you of new messages.
# OPTIONAL: without it the form still works and still writes every submission to
# the contact_submissions table — it just records "RESEND_API_KEY not set" in
# email_error instead of sending. Builds and fresh clones need no secret.
# Note that Resend will only deliver to your own account address until you
# verify a sending domain.
RESEND_API_KEY=
# Where contact form notifications are sent, and the verified domain they are
# sent from. Both fall back to sensible defaults if unset.
CONTACT_TO_EMAIL=hello@samklep.dev
CONTACT_FROM_EMAIL=contact@samklep.dev

# reCAPTCHA v3 for the contact form. OPTIONAL: with both unset the form still
# works (the honeypot stays active) and server-side verification is skipped.
# Create a v3 site at https://www.google.com/recaptcha/admin, register your
# domains (samklep.dev, the *.vercel.app preview host, and localhost), then set:
#   NEXT_PUBLIC_RECAPTCHA_SITE_KEY — the public site key (sent to the browser)
#   RECAPTCHA_SECRET_KEY           — the private key (server-side verify only)
# Submissions scoring below 0.5 are rejected (see src/lib/recaptcha.ts).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Admin section (single admin). Generate the hash with:
#   npm run admin:hash -- "your-password"
# and set a long random string for the JWT secret (e.g. `openssl rand -hex 32`).
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
